Table users [headercolor: #2563eb] {
  id int [pk, increment, note: '用户主键']
  email varchar(255) [unique, not null, note: '登录邮箱']
  name varchar [not null, note: '显示名称']
  created_at timestamp [default: `now()`, note: '注册时间']

  Note: '注册用户'
}

Enum product_status {
  draft [note: '草稿，尚未上架']
  active [note: '在售']
  archived [note: '已下架']
}

Table products {
  id int [pk, increment, note: '商品主键']
  name varchar [not null, note: '商品名称']
  price decimal(10,2) [not null, note: '销售单价']
  status product_status [not null, default: 'draft', note: '上架状态']

  Note: '在售商品'
}

Table orders {
  id int [pk, increment, note: '订单主键']
  user_id int [not null, ref: > users.id, note: '下单用户']
  status varchar [not null, note: '订单状态，如待支付、已发货']
  total decimal(10,2) [not null, default: 0, note: '订单金额']
  created_at timestamp [note: '下单时间']

  indexes {
    (user_id, created_at) [name: 'orders_user_created']
  }

  Note: '用户下单后的订单头'
}

Table order_items {
  id int [pk, increment, note: '订单项主键']
  order_id int [not null, ref: > orders.id, note: '所属订单']
  product_id int [not null, ref: > products.id, note: '购买的商品']
  quantity int [not null, default: 1, note: '购买数量']
  price decimal(10,2) [not null, note: '下单时的成交单价']

  Note: '订单中的一行商品'
}
